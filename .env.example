# giTrack local development environment
#
# All LLM and GitHub credentials are configured per-user in the
# browser Settings page and stored in localStorage.
# These env vars serve ONLY as optional local-dev defaults.

# Session cookie encryption key (optional — falls back to a built-in default).
# Generate with: openssl rand -hex 32
# SETTINGS_ENCRYPTION_KEY=

# For local dev without signing in, you can set a fallback provider+key here.
# In production (OpenShift) these are NOT used — users configure via Settings.
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
