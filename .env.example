# Fine-grained or classic PAT: repo read for private repos you can access.
# For org rollout, replace with GitHub App installation token or per-user OAuth (see README).
GITHUB_TOKEN=

# Anthropic API key (server-side only; never commit real values).
ANTHROPIC_API_KEY=

# Optional override (default in code is a widely available Sonnet snapshot).
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq API key (server-side only; never commit real values).
GROQ_API_KEY=

# Optional Groq override model (OpenAI-compatible chat completions).
# GROQ_MODEL=llama3-70b-8192

# Ollama base URL (default: http://localhost:11434).
# Setting this auto-selects Ollama as the provider.
# OLLAMA_HOST=http://localhost:11434

# Optional Ollama model override (default: llama3).
OLLAMA_MODEL=llama3

# Vertex AI (Anthropic models via Google Cloud) — requires GCP project + ADC credentials.
# VERTEX_PROJECT_ID=my-gcp-project
# VERTEX_REGION=us-east5
# VERTEX_MODEL=claude-sonnet-4@20250514

# GCP service account key JSON for Vertex AI (required when ADC is unavailable, e.g. OpenShift).
# Paste the full JSON content from `gcloud iam service-accounts keys create`.
# VERTEX_SA_KEY={"type":"service_account","project_id":"...","private_key":"...",...}

# Which LLM provider to use for AI features.
# - "anthropic" forces Anthropic
# - "groq" forces Groq
# - "ollama" forces Ollama (local)
# - "vertex" forces Vertex AI (Anthropic models via GCP)
# - if unset: auto-detects (Ollama if OLLAMA_HOST set, Vertex if VERTEX_PROJECT_ID set, Groq if GROQ_API_KEY set, otherwise Anthropic)
LLM_PROVIDER=Ollama

# Encryption key for user settings stored server-side.
# Generate with: openssl rand -hex 32
# SETTINGS_ENCRYPTION_KEY=
